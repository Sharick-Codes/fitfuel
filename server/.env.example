# Server Port (Render sets this automatically)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas: https://www.mongodb.com/atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fitfuel?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret (any strong random text)
JWT_SECRET=fitfuel_super_secure_jwt_secret_key_2026

# JWT Expiration Period
JWT_EXPIRE=30d

# Node Environment
NODE_ENV=production

# Frontend Client URL (optional, only needed if deploying frontend separately on Vercel)
# CLIENT_URL=https://your-fitfuel-app.vercel.app

